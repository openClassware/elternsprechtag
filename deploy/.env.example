# Vorlage für die `.env` neben `compose.yaml` auf dem Server.
# Die echte `.env` wird beim Deploy aus GitHub Secrets erzeugt und liegt NIE im Repository.
#
#   cp .env.example .env   # und Werte eintragen
#
# Jeder Eintrag ist Pflicht: `compose.yaml` trägt keine Zweit-Defaults, ein fehlender
# Wert bricht den Stack-Start ab.
#
# ACHTUNG: Compose interpoliert `$…` in den Werten dieser Datei. Enthält ein Geheimnis
# ein `$`, muss jedes `$` als `$$` verdoppelt werden — sonst verschwinden die Teile
# dahinter als leere Variablen:
#   $2a$10$abc…  =>  $$2a$$10$$abc…
# Betrifft in der Praxis vor allem den bcrypt-Hash in ORGANIZER_PASSWORD.

# Image aus der GitHub Container Registry (setzt der Deploy-Workflow auf den Commit-Tag).
APP_IMAGE=ghcr.io/openclassware/elternsprechtag:latest

# Öffentlicher Endpunkt (A-Record zeigt auf diesen Server) und ACME-Kontaktadresse.
DEMO_DOMAIN=demo.openclassware.de
ACME_EMAIL=

# Interne PostgreSQL-Datenbank (kein Port nach außen).
POSTGRES_DB=elternsprechtag
POSTGRES_USER=elternsprechtag
POSTGRES_PASSWORD=

# Organizer-Zugang der Demo. ORGANIZER_PASSWORD_HASH ist der NACKTE bcrypt-Hash ohne
# {bcrypt}-Präfix (das Präfix setzt application.properties).
#
# Hash erzeugen und dabei gleich wie oben beschrieben escapen:
#   docker run --rm httpd:alpine htpasswd -nbBC 10 "" 'GeheimesDemoPasswort' \
#     | cut -d: -f2 | sed 's/\$/$$/g'
ORGANIZER_USERNAME=user
ORGANIZER_PASSWORD_HASH=
